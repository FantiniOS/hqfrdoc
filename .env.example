# ==============================================================================
# FRdoc HQ — Variáveis de Ambiente
# Copie este arquivo para .env (local) e configure as mesmas variáveis na Vercel.
# NUNCA exponha nenhuma destas variáveis com prefixo NEXT_PUBLIC_.
# ==============================================================================

# 1. Banco de Dados Supabase (PostgreSQL)
# Transaction Pooler (porta 6543) — usada em runtime pelas APIs e Server Components
DATABASE_URL="postgresql://postgres.[SEU_PROJECT_REF]:[SUA_SENHA_URL_ENCODED]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct / Session Connection (porta 5432) — usada pelo Prisma para db push e migrations
DIRECT_URL="postgresql://postgres:[SUA_SENHA_URL_ENCODED]@db.[SEU_PROJECT_REF].supabase.co:5432/postgres"

# 2. Autenticação Exclusiva do Proprietário
# Usuário único de acesso ao painel HQ
HQ_ADMIN_USER="admin"

# Hash da senha gerado pelo comando: npm run hash-password
# Aceita formato scrypt:salt:hash (gerado pelo script) ou bcrypt ($2a$/$2b$)
HQ_ADMIN_PASSWORD_HASH="scrypt:SUBSTITUA_PELO_HASH_GERADO_VIA_SCRIPT"

# Segredo forte para assinar o cookie JWT (mínimo 32 caracteres aleatórios)
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
HQ_JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE_DE_64_CARACTERES"

# 3. Proteção do Cron Anti-Pausa do Supabase (Vercel Cron)
# A Vercel envia automaticamente este segredo no header Authorization: Bearer <CRON_SECRET>
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="SUBSTITUA_POR_UM_SEGREDO_FORTE_PARA_O_CRON"
